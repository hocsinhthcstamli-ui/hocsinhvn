# Copy to .env and replace YOUR_URL_ENCODED_PASSWORD locally.
# Encode special characters in the password, e.g. @ becomes %40.
# Never commit .env or paste the resulting connection string into chat.
DATABASE_URL=postgresql://postgres.ixjcnlscsubvuihixmwd:YOUR_URL_ENCODED_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://ixjcnlscsubvuihixmwd.supabase.co

# Only used when PostgreSQL has no users. Never creates demo accounts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_YOUR_ADMIN_PASSWORD
NODE_ENV=development

# Existing server settings. Use COOKIE_SECURE=1 behind Render HTTPS.
HOST=0.0.0.0
PORT=3000
COOKIE_SECURE=0
TRUST_PROXY=0

# Optional: path to the official Supabase database CA PEM if your system
# cannot verify its chain. Never disable TLS verification.
# DATABASE_CA_FILE=

# No Supabase service-role key is needed for direct PostgreSQL access
# and YouTube/Google Drive links. Images remain in PostgreSQL as card data.
# Leave DATABASE_URL empty only for local SQLite development, never Render.
